{
  "$schema": "https://raw.githubusercontent.com/agile-north/rexo/schema/v1.0/policy.schema.json",
  "schemaVersion": "1.0",
  "name": "node-policy",
  "description": "Node.js toolchain command contributions. Essential steps (install, build, test, lint) are on by default; format check, lint SARIF, and dependency audit are opt-in via vars.node.*. Usable standalone or overlaid with embedded:standard.",
  "vars": {
    "node": {
      "packageManager": "npm",
      "yarnVersion": "classic",
      "container": "",
      "restore": {
        "command": ""
      },
      "build": {
        "script": "build"
      },
      "test": {
        "script": "test"
      },
      "lint": {
        "enabled": true,
        "script": "lint"
      },
      "format": {
        "script": "format",
        "check": {
          "enabled": false,
          "script": "format:check"
        }
      },
      "sarif": {
        "enabled": false,
        "script": "lint:sarif"
      },
      "audit": {
        "enabled": false,
        "level": "high"
      }
    }
  },
  "containers": {
    "node": {
      "image": "docker.io/library/node:lts",
      "workingDirectory": "/work"
    }
  },
  "commands": {
    "restore": {
      "description": "Install Node.js dependencies using the lockfile (npm ci / pnpm|yarn|bun install --frozen-lockfile).",
      "container": "{{vars.node.container}}",
      "steps": [
        {
          "id": "node-install-custom",
          "when": "{{vars.node.restore.command != ''}}",
          "run": "{{vars.node.restore.command}}"
        },
        {
          "id": "node-install",
          "when": "{{vars.node.restore.command == '' && (vars.node.packageManager == 'npm' || vars.node.packageManager == '')}}",
          "run": "npm ci"
        },
        {
          "id": "node-install-pnpm",
          "when": "{{vars.node.restore.command == '' && vars.node.packageManager == 'pnpm'}}",
          "run": "pnpm install --frozen-lockfile"
        },
        {
          "id": "node-install-yarn",
          "when": "{{vars.node.restore.command == '' && vars.node.packageManager == 'yarn'}}",
          "run": "yarn install --frozen-lockfile"
        },
        {
          "id": "node-install-bun",
          "when": "{{vars.node.restore.command == '' && vars.node.packageManager == 'bun'}}",
          "run": "bun install --frozen-lockfile"
        }
      ]
    },
    "build": {
      "description": "Build Node.js project.",
      "container": "{{vars.node.container}}",
      "steps": [
        {
          "id": "node-build",
          "run": "{{vars.node.packageManager | default('npm')}} run {{vars.node.build.script | default('build')}}"
        }
      ]
    },
    "test": {
      "description": "Run Node.js tests.",
      "container": "{{vars.node.container}}",
      "steps": [
        {
          "id": "node-test",
          "run": "{{vars.node.packageManager | default('npm')}} run {{vars.node.test.script | default('test')}}",
          "outputs": {
            "testResults": [
              "{{outputs.tests.results}}/**/*.xml",
              "{{outputs.tests.results}}/**/*.json"
            ],
            "coverage": [
              "{{outputs.tests.coverage}}/**/*"
            ]
          }
        }
      ]
    },
    "analyze": {
      "description": "Lint Node.js source files (lint on by default; format check and SARIF are opt-in).",
      "container": "{{vars.node.container}}",
      "steps": [
        {
          "id": "node-lint",
          "when": "{{vars.node.lint.enabled}}",
          "run": "{{vars.node.packageManager | default('npm')}} run {{vars.node.lint.script | default('lint')}}",
          "outputs": {
            "analysisReports": [
              "{{outputs.analysis.reports}}/**/*"
            ]
          }
        },
        {
          "id": "node-format-check",
          "when": "{{vars.node.format.check.enabled}}",
          "run": "{{vars.node.packageManager | default('npm')}} run {{vars.node.format.check.script | default('format:check')}}"
        },
        {
          "id": "node-lint-sarif",
          "when": "{{vars.node.sarif.enabled}}",
          "run": "{{vars.node.packageManager | default('npm')}} run {{vars.node.sarif.script | default('lint:sarif')}}",
          "outputs": {
            "sarifReports": [
              "{{outputs.analysis.sarif}}/**/*.sarif"
            ]
          }
        }
      ]
    },
    "format": {
      "description": "Auto-format Node.js source files.",
      "container": "{{vars.node.container}}",
      "steps": [
        {
          "id": "node-format",
          "run": "{{vars.node.packageManager | default('npm')}} run {{vars.node.format.script | default('format')}}"
        }
      ]
    },
    "security": {
      "description": "Audit Node.js dependencies for known vulnerabilities (opt-in: vars.node.audit.enabled=true).",
      "container": "{{vars.node.container}}",
      "steps": [
        {
          "id": "node-audit-npm",
          "when": "{{vars.node.audit.enabled && (vars.node.packageManager == 'npm' || vars.node.packageManager == '')}}",
          "run": "npm audit --json --audit-level={{vars.node.audit.level | default('high')}}{{outputs.security.audit | prefix(' > ')}}",
          "outputs": {
            "securityReports": [
              "{{outputs.security.audit}}"
            ]
          }
        },
        {
          "id": "node-audit-pnpm",
          "when": "{{vars.node.audit.enabled && vars.node.packageManager == 'pnpm'}}",
          "run": "pnpm audit --json --audit-level={{vars.node.audit.level | default('high')}}{{outputs.security.audit | prefix(' > ')}}",
          "outputs": {
            "securityReports": [
              "{{outputs.security.audit}}"
            ]
          }
        },
        {
          "id": "node-audit-yarn-classic",
          "when": "{{vars.node.audit.enabled && vars.node.packageManager == 'yarn' && (vars.node.yarnVersion == 'classic' || vars.node.yarnVersion == '')}}",
          "run": "yarn audit --json --level={{vars.node.audit.level | default('high')}}{{outputs.security.audit | prefix(' > ')}}",
          "outputs": {
            "securityReports": [
              "{{outputs.security.audit}}"
            ]
          }
        },
        {
          "id": "node-audit-yarn-modern",
          "when": "{{vars.node.audit.enabled && vars.node.packageManager == 'yarn' && vars.node.yarnVersion == 'modern'}}",
          "run": "yarn npm audit --json --severity {{vars.node.audit.level | default('high')}}{{outputs.security.audit | prefix(' > ')}}",
          "outputs": {
            "securityReports": [
              "{{outputs.security.audit}}"
            ]
          }
        },
        {
          "id": "node-audit-bun",
          "when": "{{vars.node.audit.enabled && vars.node.packageManager == 'bun'}}",
          "run": "bun audit --json --audit-level={{vars.node.audit.level | default('high')}}{{outputs.security.audit | prefix(' > ')}}",
          "outputs": {
            "securityReports": [
              "{{outputs.security.audit}}"
            ]
          }
        }
      ]
    }
  }
}
